<Project>

  <!--
    Central Package Management: the version of every NuGet package used in src/, tests/ and samples/ is set here,
    once. The PackageReference items in the projects have no Version attribute.
    https://learn.microsoft.com/nuget/consume-packages/central-package-management
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Libraries (src/) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="10.0.14" />
    <PackageVersion Include="System.Net.ServerSentEvents" Version="10.0.14" />
    <PackageVersion Include="System.Text.Json" Version="10.0.14" />
  </ItemGroup>

  <!-- Tests (tests/) -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <!-- Tests and samples -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
  </ItemGroup>

  <!-- Samples (samples/) -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
  </ItemGroup>

</Project>
