<Project>

  <!-- Common settings for all the packages in src/ -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <NeutralLanguage>en</NeutralLanguage>
    <Authors>Federico Mazzanti</Authors>
    <Copyright>Copyright (c) 2020-2026 Federico Mazzanti</Copyright>
    <Company />
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/fmazzant/RestClient</RepositoryUrl>
    <PackageProjectUrl>https://github.com/fmazzant/RestClient</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;RS0026;RS0027</NoWarn>
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Package validation: checks that the API is consistent across the target frameworks and compares
         the package with the last released version (baseline), downloaded from NuGet.org.
         The public API of the last release is frozen in PublicAPI.Shipped.txt; new or removed members go in PublicAPI.Unshipped.txt.
         Members that exist only on .NET (net8.0+) are tracked in PublicAPI/net/ (see RestClient.csproj).
         Intentional breaking changes against the baseline are recorded in CompatibilitySuppressions.xml
         (next to the .csproj), regenerated with:
           dotnet pack -c Release src/RestClient.sln -p:ApiCompatGenerateSuppressionFile=true
         After every release move PackageValidationBaselineVersion to the released version. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>3.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE" Pack="true" PackagePath="" Visible="false" />
    <!-- Every package has its own short README.md (next to the .csproj), shown on nuget.org -->
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)..\assets\icon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!-- Every change to the public API must be recorded in PublicAPI.Unshipped.txt -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
