<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.1;netstandard2.0</TargetFrameworks>
    <AssemblyName>Mafe.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>RestClient</RootNamespace>
    <PackageId>Mafe.RestClient</PackageId>
    <Product>RestClient</Product>
    <Description>RestClient is a fluent library for .NET that helps you to consume REST services.</Description>
    <PackageTags>rest-client, c-sharp, dotnet-standard, dotnet-core, dotnet-framework, http-client, restclient, mafe, xml, json, rest, fluent</PackageTags>
    <PackageReleaseNotes>
      2.0.0 (breaking changes, see README "Migrating to 2.0")
      - Target frameworks: net10.0, net8.0, netstandard2.1, netstandard2.0 (.NET Framework 4.6.2+ via netstandard2.0)
      - Removed EOL targets and Newtonsoft.Json, removed all [Obsolete] members
      - Pooled HTTP handlers: connections are reused across requests (no more socket exhaustion)
      - Removed the global ServicePointManager callback that disabled TLS certificate validation for the whole process
      - Immutable builder: every fluent call returns an independent copy
      - Smaller API: SendAsync&lt;T&gt;(method) + Get/Post/Put/Patch/Delete/Head/Options; T can be string, byte[], Stream or a DTO
      - Real streaming for Stream results, streaming JSON deserialization
      - RestResult&lt;T&gt; moved to the RestClient namespace
      - Query string: url-encoded, invariant culture, repeated keys
      - Built-in retry policy, refresh token de-duplicated across concurrent requests
      - multipart/form-data uploads
      - Native AOT and trimming friendly JSON (JsonSerializerContext)
      - ILogger logging and OpenTelemetry tracing (ActivitySource "Mafe.RestClient")
      - Nullable reference types annotations
      - New package Mafe.RestClient.Extensions.DependencyInjection (IHttpClientFactory integration)

      1.9.5
      - Target .NET 8.0 (net8.0)
      - Upgrade all dependences
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETStandard'">
    <PackageReference Include="System.Text.Json" Version="10.0.14" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.14" />
  </ItemGroup>

</Project>
