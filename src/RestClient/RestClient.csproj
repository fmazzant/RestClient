<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.1;netstandard2.0</TargetFrameworks>
    <AssemblyName>Mafesoft.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Mafesoft.RestClient</RootNamespace>

    <!-- NuGet package metadata. The publish workflow checks that the git tag (v3.0.0)
         matches Version, here and in Mafesoft.RestClient.Extensions.DependencyInjection. -->
    <PackageId>Mafesoft.RestClient</PackageId>
    <Product>RestClient</Product>
    <Title>Mafesoft.RestClient</Title>
    <Version>3.1.1</Version>
    <Description>RestClient is a fluent library for .NET that helps you to consume REST services.</Description>
    <PackageTags>rest-client, c-sharp, dotnet-standard, dotnet-core, dotnet-framework, http-client, restclient, mafesoft, xml, json, rest, fluent</PackageTags>
    <!-- Only the current version: the full history is in CHANGELOG.md -->
    <PackageReleaseNotes>
      3.1.1 (no breaking changes)
      - No changes to the library code: same features as 3.1.0 (build and tests only)

      Full changelog: https://github.com/fmazzant/RestClient/blob/main/CHANGELOG.md
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- Public API available only on .NET (net8.0+), e.g. HttpVersionPolicy -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <AdditionalFiles Include="PublicAPI\net\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI\net\PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETStandard'">
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
  </ItemGroup>

  <!-- System.Net.ServerSentEvents (SseParser, SseItem<T>) is part of .NET 9+; older targets use the package -->
  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net9.0'))">
    <PackageReference Include="System.Net.ServerSentEvents" />
  </ItemGroup>

</Project>
