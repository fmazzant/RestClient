<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Only nuget.org: the packages of this repository come from a single source, whatever is configured on the machine.
    With Central Package Management (Directory.Packages.props) more than one source gives warning NU1507,
    an error in the projects with TreatWarningsAsErrors (samples/, the Native AOT smoke test).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

</configuration>
